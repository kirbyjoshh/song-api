# Supabase database settings for song-api
# Copy this file to .env and fill in your Supabase values.

DATABASE_URL=postgres://postgres:<your-password>@<project-ref>.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=<your-password>

# Optional: if your Supabase URL already includes sslmode, leave it as-is.
# DATABASE_URL=jdbc:postgresql://<project-ref>.supabase.co:5432/postgres?sslmode=require
